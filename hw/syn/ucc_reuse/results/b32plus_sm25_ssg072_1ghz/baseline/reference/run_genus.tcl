# Genus synthesis of one Vortex core configured as a B200 SM (RTA bench), TSMC N28, 1 GHz.
# Reads design-specific params from ../config.tcl; launched by Makefile.flow with DESIGN_ROOT set.
# MODE (env, default "syn"): "elab" stops after elaboration and lists the RAM black boxes (sizes for the
# memory compiler); "syn" runs the full flow and writes the hierarchical area breakdown.

if {![info exists ::env(DESIGN_ROOT)]} {
    error "run_genus.tcl: env DESIGN_ROOT is not set"
}
set ::flow_root [file normalize $::env(DESIGN_ROOT)]
set ::pnr_root  /data/eda_tools/script/pnr/tsmcn28
set mode [expr {[info exists ::env(MODE)] ? $::env(MODE) : "syn"}]

source [file join $::flow_root config.tcl]

set design     $cfg(design)
set filelist   $cfg(rtl_filelist)
set ::sdc_file $cfg(sdc)

set outputs_dir outputs
set reports_dir reports
set logs_dir    logs
foreach d [list $outputs_dir $reports_dir $logs_dir] {
    if {![file exists $d]} { file mkdir $d }
}

# --- Pre-elaboration knobs ---
# The RAMs (VX_dp_ram_asic / VX_sp_ram_asic) are port-only stubs: black boxes to be replaced by memory macros.
set_db hdl_error_on_blackbox             false
set_db hdl_auto_sync_set_reset           true
set_db hdl_unconnected_value             none
set_db hdl_unconnected_input_port_value  none
set_db hdl_undriven_output_port_value    none
set_db hdl_undriven_signal_value         none
set_db hdl_language                      sv
set_db hdl_track_filename_row_col        true
set_db lp_insert_clock_gating            true
set_db lp_clock_gating_infer_enable      true
set_db lp_clock_gating_prefix            CKG
set_db lp_power_unit                     mW
set_db tns_opto                          true
set_db optimize_constant_0_flops         true
set_db optimize_constant_1_flops         true
set_db delete_unloaded_seqs              true
set_db leakage_power_effort              medium
set_db lib_lef_consistency_check_enable  true
set_db lef_cap_consistency_check_enable  false
set_db max_cpus_per_server               16

# --- MMMC + physical (shared flow, plus the memory-compiler macros when RAMS=macros) ---
# RAMS (env, default "stubs"): "stubs" keeps the RAMs as empty black boxes (elaboration / RAM census);
# "macros" reads mem/<design>/VX_ram_macros.sv (generated by mem/gen_macros.py) and the macro .lib / LEF files.
set rams [expr {[info exists ::env(RAMS)] ? $::env(RAMS) : "stubs"}]
set ::macro_root [file join $::flow_root .. mem [file tail $::flow_root]]
set ::macro_lefs {}
source [file join $::pnr_root flow setup tsmcn28_libs.tcl]
if {$rams == "macros"} {
    source [file join $::macro_root macros.tcl]
    set filelist [file join $::flow_root syn filelist_macros.f]
}
source [file join $::flow_root syn mmmc_build_macros.tcl]
read_physical -lef [concat $tsmcn28_lefs $::macro_lefs]

# --- RTL ---
read_hdl -sv -f $filelist
elaborate $design
init_design -top $design

# --- RAM black boxes: one line per instance with its parameters (module names carry them) ---
set fh [open $reports_dir/${design}_rams.txt w]
foreach inst [get_db hinsts -if {.module.name == VX_dp_ram_asic* || .module.name == VX_sp_ram_asic*}] {
    puts $fh "[get_db $inst .name] [get_db $inst .module.name]"
}
close $fh
report_hierarchy > $reports_dir/${design}_hierarchy_elab.rpt

if {$mode == "elab"} {
    puts "RTA: elaboration done, RAM list in $reports_dir/${design}_rams.txt"
    quit
}

# --- Synthesis: keep the unit hierarchy for the area breakdown (no ungroup, no retiming) ---
set_db [current_design] .lp_clock_gating_hierarchical true
set_db root: .auto_ungroup none
check_timing_intent

set_db syn_generic_effort medium
syn_generic
set_db syn_map_effort     medium
syn_map
set_db syn_opt_effort     medium
syn_opt

report_timing > $reports_dir/${design}_timing.rpt
report_area   > $reports_dir/${design}_area.rpt
report_area -depth 6 > $reports_dir/${design}_area_hier.rpt
report_power  > $reports_dir/${design}_power.rpt
report_qor    > $reports_dir/${design}_qor.rpt
report_gates  > $reports_dir/${design}_gates.rpt

write_hdl                       > $outputs_dir/${design}.mapped.v
write_sdc -view SS.setup_view   > $outputs_dir/${design}.mapped.sdc

if {![file exists $outputs_dir/db]} { file mkdir $outputs_dir/db }
write_db -common $outputs_dir/db/${design}

quit
